# Which provider to use: claude, google or opencode.
# Leave this blank when only one key below is set. That key chooses the provider.
AI_PROVIDER=

# Claude. ANTHROPIC_API_KEY is accepted as the same key.
CLAUDE_API_KEY=

# Gemini, from Google AI Studio.
GOOGLE_API_KEY=

# OpenCode (opencode.ai/console). Runs the same Claude model through OpenCode's API.
OPENCODE_API_KEY=

# Postgres. This matches the local database in docker-compose.yml.
DATABASE_URL=postgres://fluency:fluency@localhost:5432/fluency
# Production only: the secret the daily sweep's scheduler sends (/api/cron/sweep, FLU-99).
# CRON_SECRET=

# Production only (README, Deployment): the schema owner's URL for migrations, when DATABASE_URL
# is the app's own login, and 1 connection per serverless instance.
# MIGRATION_DATABASE_URL=
# DATABASE_POOL_MAX=1

# Azure Speech, for pronunciation assessment. Region close to Bangladesh, e.g. southeastasia.
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=
AZURE_ENDPOINT=https://southeastasia.api.cognitive.microsoft.com/

# LiveKit Cloud: WebRTC for live voice. Deepgram speech models also run through
# LiveKit Inference with these keys, so there is no Deepgram key.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The voice worker's name: a worker registers under it and the app dispatches to it. Keep
# fluency-tutor-dev here. Only the deployed worker and the production app use fluency-tutor,
# so a worker on your machine never takes a production session. Live voice is off without it.
VOICE_AGENT_NAME=fluency-tutor-dev

# Text-to-speech candidates for the A/B test.
CARTESIA_API_KEY=
GRADIUM_API_KEY=
