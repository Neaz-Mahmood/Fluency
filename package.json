{
  "name": "fluency",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "eval": "node --conditions=react-server --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/eval/eval.ts",
    "voice:ttft": "node --conditions=react-server --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/voice/ttft.ts",
    "voice:tts-ab": "node --conditions=react-server --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/voice/tts-ab.ts",
    "voice:azure": "node --conditions=react-server --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/voice/azure-pron.ts",
    "voice:worker": "node --conditions=react-server --import ./worker/resolve-hook.ts --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON worker/main.ts",
    "voice:call": "node --conditions=react-server --import ./worker/resolve-hook.ts --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/voice/call.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:db": "vitest run --project db"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@base-ui/react": "^1.9.0",
    "@livekit/agents": "^1.9.4",
    "@livekit/rtc-node": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "livekit-client": "2.22.4",
    "livekit-server-sdk": "^2.19.2",
    "lucide-react": "^1.56.0",
    "microsoft-cognitiveservices-speech-sdk": "1.53.0",
    "next": "16.4.3",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "ts-fsrs": "^5.4.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.25.0"
}
